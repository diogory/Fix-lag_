local function clearHit()
	for m,h in pairs(hits) do
		if h then
			h:Destroy()
		end

		hits[m]=nil
	end
end

local function updateHit()
	if not hit then
		clearHit()
		hitLabel.Text="TARGETS: 0"
		return
	end

	local targets=getTargets(hitType)
	local active={}

	for _,m in ipairs(targets) do
		active[m]=true

		local h=hits[m]

		if not h then
			h=Instance.new("Highlight")
			h.Name="HitboxDebug"
			h.Adornee=m
			h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
			h.FillTransparency=.38
			h.OutlineTransparency=0
			h.Parent=m
			hits[m]=h
		end

		if hitType=="NPC" then
			h.FillColor=Color3.fromRGB(0,255,120)
			h.OutlineColor=Color3.fromRGB(150,255,200)
		else
			h.FillColor=Color3.fromRGB(0,210,255)
			h.OutlineColor=Color3.fromRGB(170,240,255)
		end
	end

	for m,h in pairs(hits) do
		if not active[m] or not m.Parent then
			h:Destroy()
			hits[m]=nil
		end
	end

	hitLabel.Text="TARGETS: "..#targets
end

