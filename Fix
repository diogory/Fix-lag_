RunService.Heartbeat:Connect(function(dt)

	aimClock+=dt
	hitClock+=dt

	if noclip then
		local char=LP.Character

		if char then
			for _,o in ipairs(char:GetDescendants()) do
				if o:IsA("BasePart") then
					o.CanCollide=false
				end
			end
		end
	end

	if speedOn then
		local char=LP.Character
		local hum=char and char:FindFirstChildOfClass("Humanoid")

		if hum then
			hum.WalkSpeed=speed
		end
	end

	if aim and aimClock>=.016 then
		aimClock=0
		updateAim()
	end

	if hit and hitClock>=.08 then
		hitClock=0
		updateHit()
	end
end)

RunService.RenderStepped:Connect(function(dt)

	fpsCount+=1
	fpsClock+=dt

	if fpsClock>=.5 then

		local f=math.floor(fpsCount/fpsClock)
		f=math.clamp(f,0,300)

		fpsLabel.Text="FPS "..f

		if f>=120 then
			fpsLabel.TextColor3=Color3.fromRGB(120,255,120)
		elseif f>=60 then
			fpsLabel.TextColor3=Color3.fromRGB(255,220,80)
		else
			fpsLabel.TextColor3=Color3.fromRGB(255,80,80)
		end

		fpsCount=0
		fpsClock=0
	end
end)

