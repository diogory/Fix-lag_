local function saveObject(o)
	if saved[o] then return end

	if o:IsA("ParticleEmitter") then
		saved[o]={1,o.Enabled,o.Rate}
	elseif o:IsA("Trail") or o:IsA("Beam") then
		saved[o]={2,o.Enabled}
	elseif o:IsA("PointLight")
	or o:IsA("SpotLight")
	or o:IsA("SurfaceLight") then
		saved[o]={3,o.Enabled,o.Shadows}
	elseif o:IsA("PostEffect") then
		saved[o]={4,o.Enabled}
	elseif o:IsA("BasePart") then
		saved[o]={5,o.CastShadow}
	end
end

local function perfFix(mode)
	perf=mode

	if mode=="OFF" then
		Lighting.GlobalShadows=oldShadow
		Lighting.EnvironmentDiffuseScale=oldDiffuse
		Lighting.EnvironmentSpecularScale=oldSpecular

		for o,d in pairs(saved) do
			if o.Parent then
				if d[1]==1 then
					o.Enabled=d[2]
					o.Rate=d[3]
				elseif d[1]==2 then
					o.Enabled=d[2]
				elseif d[1]==3 then
					o.Enabled=d[2]
					o.Shadows=d[3]
				elseif d[1]==4 then
					o.Enabled=d[2]
				elseif d[1]==5 then
					o.CastShadow=d[2]
				end
			end
		end

		return
	end

	Lighting.GlobalShadows=false
	Lighting.EnvironmentDiffuseScale=.35
	Lighting.EnvironmentSpecularScale=.1

	local ultraMode=mode=="ULTRA"

	for _,o in ipairs(Workspace:GetDescendants()) do
		saveObject(o)

		if o:IsA("ParticleEmitter") then
			if ultraMode then
				o.Enabled=false
			else
				o.Rate=o.Rate*.25
			end
		elseif o:IsA("Trail") or o:IsA("Beam") then
			if ultraMode then
				o.Enabled=false
			end
		elseif o:IsA("PointLight")
		or o:IsA("SpotLight")
		or o:IsA("SurfaceLight") then
			o.Enabled=false
		elseif o:IsA("PostEffect") then
			o.Enabled=false
		elseif o:IsA("BasePart") then
			o.CastShadow=false
		end
	end
end

