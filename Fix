local function validPlayer(m)
	if not m:IsA("Model") then return false end
	if not Players:GetPlayerFromCharacter(m) then return false end

	local h=m:FindFirstChildOfClass("Humanoid")
	local r=m:FindFirstChild("HumanoidRootPart")

	return h and r and h.Health>0
end

local function validNPC(m)
	if not m:IsA("Model") then return false end
	if Players:GetPlayerFromCharacter(m) then return false end

	local h=m:FindFirstChildOfClass("Humanoid")
	local r=m:FindFirstChild("HumanoidRootPart")

	return h and r and h.Health>0
end

local function getTargets(kind)
	local list={}

	if kind=="PLAYER" then
		for _,p in ipairs(Players:GetPlayers()) do
			if p~=LP and p.Character and validPlayer(p.Character) then
				list[#list+1]=p.Character

				if #list>=MAX_TARGETS then
					break
				end
			end
		end
	else
		for _,m in ipairs(Workspace:GetChildren()) do
			if validNPC(m) then
				list[#list+1]=m

				if #list>=MAX_TARGETS then
					break
				end
			end
		end
	end

	return list
end

local function clearAim()
	aimTarget=nil

	if aimMark then
		aimMark:Destroy()
		aimMark=nil
	end

	aimLabel.Text="TARGET: --"
end

local function validAimTarget(m)
	if not m or not m.Parent then
		return false
	end

	local h=m:FindFirstChildOfClass("Humanoid")
	local r=m:FindFirstChild("HumanoidRootPart")

	if not h or not r or h.Health<=0 then
		return false
	end

	if aimType=="PLAYER" then
		return Players:GetPlayerFromCharacter(m)~=nil
	else
		return Players:GetPlayerFromCharacter(m)==nil
	end
end

local function findAimTarget()
	local char=LP.Character
	local myRoot=char and char:FindFirstChild("HumanoidRootPart")

	if not myRoot then
		return nil
	end

	local best=nil
	local bestDistance=math.huge

	for _,m in ipairs(getTargets(aimType)) do
		if validAimTarget(m) then
			local root=m:FindFirstChild("HumanoidRootPart")

			if root then
				local distance=(root.Position-myRoot.Position).Magnitude

				if distance<bestDistance then
					bestDistance=distance
					best=m
				end
			end
		end
	end

	return best
end

local function updateAim()
	if not aim then
		clearAim()
		return
	end

	local cam=Workspace.CurrentCamera
	local char=LP.Character
	local myRoot=char and char:FindFirstChild("HumanoidRootPart")

	if not cam or not myRoot then
		return
	end

	if not validAimTarget(aimTarget) then
		aimTarget=findAimTarget()
	end

	if not aimTarget then
		aimLabel.Text="TARGET: --"
		return
	end

	local targetRoot=aimTarget:FindFirstChild("HumanoidRootPart")

	if not targetRoot then
		clearAim()
		return
	end

	local direction=targetRoot.Position-cam.CFrame.Position

	if direction.Magnitude>0 then
		local desiredLook=direction.Unit
		local currentLook=cam.CFrame.LookVector
		local newLook=currentLook:Lerp(
			desiredLook,
			AIM_SMOOTH
		)

		cam.CFrame=CFrame.lookAt(
			cam.CFrame.Position,
			cam.CFrame.Position+newLook
		)
	end

	if not aimMark then
		aimMark=Instance.new("Highlight")
		aimMark.Name="AimDebug"
		aimMark.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
		aimMark.FillTransparency=.22
		aimMark.OutlineTransparency=0
	end

	aimMark.Adornee=aimTarget
	aimMark.Parent=aimTarget

	if aimType=="NPC" then
		aimMark.FillColor=Color3.fromRGB(255,170,0)
		aimMark.OutlineColor=Color3.fromRGB(255,245,120)
	else
		aimMark.FillColor=Color3.fromRGB(255,70,220)
		aimMark.OutlineColor=Color3.fromRGB(255,190,245)
	end

	aimLabel.Text="TARGET: "..aimTarget.Name
end

