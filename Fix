UIS.InputChanged:Connect(function(i)

	if sliding and (
		i.UserInputType==Enum.UserInputType.Touch
		or i.UserInputType==Enum.UserInputType.MouseMovement
	) then
		slide(i.Position.X)
	end

	if miniDragging and (
		i.UserInputType==Enum.UserInputType.Touch
		or i.UserInputType==Enum.UserInputType.MouseMovement
	) then

		local d=i.Position-miniDragStart

		mini.Position=UDim2.new(
			miniStartPos.X.Scale,
			miniStartPos.X.Offset+d.X,
			miniStartPos.Y.Scale,
			miniStartPos.Y.Offset+d.Y
		)
	end

	if fpsDragging and (
		i.UserInputType==Enum.UserInputType.Touch
		or i.UserInputType==Enum.UserInputType.MouseMovement
	) then

		local d=i.Position-fpsDragStart

		fpsBox.Position=UDim2.new(
			fpsStartPos.X.Scale,
			fpsStartPos.X.Offset+d.X,
			fpsStartPos.Y.Scale,
			fpsStartPos.Y.Offset+d.Y
